{
  "name": "gaql-library",
  "version": "1.0.0",
  "description": "A library for working with Google Ads Query Language (GAQL)",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --outfile=dist/index.js --format=cjs",
    "build:watch": "esbuild src/index.js --bundle --platform=node --outfile=dist/index.js --format=cjs --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node dist/index.js",
    "dev": "npm run build:watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "google-ads",
    "gaql",
    "query-language",
    "google-ads-api",
    "advertising"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.19.8",
    "eslint": "^8.53.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "google-ads-api": "^21.0.1"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/gaql-library.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/gaql-library/issues"
  },
  "homepage": "https://github.com/yourusername/gaql-library#readme"
}
