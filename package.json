{
  "name": "@growth-nirvana/gaql-executor",
  "version": "1.2.0",
  "description": "Composable GAQL executor + pipeline steps for the Google Ads API",
  "license": "MIT",
  "author": "Growth Nirvana",
  "repository": {
    "type": "git",
    "url": "https://github.com/growth-nirvana/gaql-executor.git"
  },
  "bugs": {
    "url": "https://github.com/growth-nirvana/gaql-executor/issues"
  },
  "homepage": "https://github.com/growth-nirvana/gaql-executor#readme",
  "type": "commonjs",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=cjs --outfile=dist/index.js --packages=external",
    "build:watch": "esbuild src/index.js --bundle --platform=node --outfile=dist/index.js --format=cjs --watch",
    "prepublishOnly": "npm run build",
    "dev": "npm run build:watch",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "preview:dev": "vite preview-test"
  },
  "keywords": [
    "google-ads",
    "gaql",
    "google-ads-api",
    "analytics",
    "pipeline"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "facebook-nodejs-business-sdk": "^23.0.1",
    "google-ads-api": "^21.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.19.8",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "vite": "^5.0.0"
  }
}
